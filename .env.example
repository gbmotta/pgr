# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env

# --- Webhook Google Drive (monitoramento automático de planilhas) ---
# Deve ser HTTPS e acessível pela internet (sem barra no final).
# Exemplo local com túnel:
#   Terminal A: uvicorn na porta 8001
#   Terminal B: ./scripts/pgr.sh tunnel 8001
#   Copie a URL https://.... da linha "Forwarding" para baixo:
WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app

# --- Outras variáveis comuns (opcional) ---
# SECRET_KEY=
# GOOGLE_WEBHOOK_SECRET=

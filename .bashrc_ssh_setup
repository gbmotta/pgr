# Adicionar ao ~/.bashrc para carregar chave SSH automaticamente ao iniciar terminal

# Iniciar ssh-agent se não estiver rodando
if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)" > /dev/null
fi

# Adicionar chave SSH se existir
if [ -f ~/.ssh/id_ed25519 ] && ! ssh-add -l | grep -q id_ed25519; then
    ssh-add ~/.ssh/id_ed25519 2>/dev/null
fi

